# Maintainer: skint007 <archlinux.repose742@passmail.net>
# Built from source by the `paw` personal repo CI (not the official AUR).
pkgname=cmd-helper
pkgver=0.0.0
pkgrel=1
pkgdesc="AI-powered command-line helper for Ollama, OpenAI, Anthropic, and DeepSeek"
arch=('x86_64')
url="https://github.com/skint007/cmd-helper"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('git' 'rust')
optdepends=(
    'jq: JSON processing commands'
    'tree: directory tree listing'
    'curl: URL fetching commands'
    'wget: file downloading commands'
    'rsync: file synchronization commands'
    'fd: modern find alternative'
    'ripgrep: fast grep alternative'
    'bat: syntax-highlighted cat alternative'
    'xclip: clipboard support for X11'
    'wl-clipboard: clipboard support for Wayland'
)
conflicts=('cmd-helper-bin' 'cmd-helper-git')
options=('!debug')   # don't split out a separate -debug package
source=("git+https://github.com/skint007/cmd-helper.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/cmd-helper"
    # Clean base version (from Cargo.toml) + a monotonic git suffix, e.g. 0.4.2.r84.a1b2c3d.
    # Every commit bumps the version, so a paw rebuild always reads as an update.
    local v r h
    v=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)
    r=$(git rev-list --count HEAD)
    h=$(git rev-parse --short=7 HEAD)
    printf '%s.r%s.%s' "$v" "$r" "$h"
}

build() {
    cd "$srcdir/cmd-helper"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # Prevent makepkg's CFLAGS/LDFLAGS from breaking bundled C compilation (SQLite via rusqlite).
    unset CFLAGS CXXFLAGS LDFLAGS
    cargo build --release --locked
}

package() {
    cd "$srcdir/cmd-helper"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
