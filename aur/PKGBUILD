# Maintainer: skint007
pkgname=cmd-helper
pkgver=0.4.0
pkgrel=1
pkgdesc="AI-powered command-line helper using Ollama"
arch=('x86_64')
url="https://github.com/skint007/cmd-helper"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'gcc')
optdepends=(
    'jq: JSON processing commands'
    'tree: directory tree listing'
    'curl: URL fetching commands'
    'wget: file downloading commands'
    'rsync: file synchronization commands'
    'fd: modern find alternative'
    'ripgrep: fast grep alternative'
    'bat: syntax-highlighted cat alternative'
    'xclip: clipboard support for X11'
    'wl-clipboard: clipboard support for Wayland'
)
# TODO: Switch to GitHub source for AUR submission:
# source=("$pkgname-$pkgver.tar.gz::https://github.com/skint007/cmd-helper/archive/v$pkgver.tar.gz")
# sha256sums=('SKIP')
source=()
sha256sums=()
_srcdir="/home/skint007/Dropbox/projects/rust/cmd-helper"

build() {
    cd "$_srcdir"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # Prevent makepkg's CFLAGS/LDFLAGS from breaking bundled C compilation (SQLite)
    unset CFLAGS CXXFLAGS LDFLAGS
    cargo build --release --locked
}

package() {
    cd "$_srcdir"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
